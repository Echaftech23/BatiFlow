# BatiFlow mobile — copy to .env. EXPO_PUBLIC_* is embedded at build time; do not put secrets here.

# API: use your machine LAN IP when testing on a physical device (same Wi‑Fi as the API).
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Firebase client (Firebase console → Project settings → Your apps → Web app config).
# These are not secret but are project-specific; iOS/Android also need GoogleService-Info.plist
# and google-services.json per Expo/Firebase documentation.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In — Web client ID is required for id_token exchange with Firebase.
# Create iOS and Android OAuth clients in Google Cloud (linked to Firebase) and add SHA-1
# for Android keystores. Paste client IDs below.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
