{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/api/*": ["api/*"],
      "@/hooks/*": ["hooks/*"],
      "@/services/*": ["services/*"],
      "@/components/*": ["components/*"],
      "@/shared/*": ["shared/*"],
      "@/providers/*": ["providers/*"],
      "@/lib/*": ["lib/*"]
    }
  }
}
