PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/batiflow
JWT_SECRET=change-me-at-least-16-chars
JWT_EXPIRES_IN=7d

# OTP (registration email) — use a long random secret; never commit real values
OTP_PEPPER=change-me-at-least-16-chars-pepper
OTP_TTL_MINUTES=15
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# Resend (leave RESEND_API_KEY empty for local dev — OTP is logged server-side)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
