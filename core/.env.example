# BatiFlow API — copy to .env and fill in real values. Never commit .env.

# -----------------------------------------------------------------------------
# Secrets: if any value was ever leaked, rotate it in the provider dashboard
# (especially Resend API keys and JWT/OTP material). Use only env vars at runtime.
# -----------------------------------------------------------------------------

PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/batiflow
JWT_SECRET=change-me-at-least-16-chars
JWT_EXPIRES_IN=7d

# OTP (registration email) — long random values; never commit real values
OTP_PEPPER=change-me-at-least-16-chars-pepper
OTP_TTL_MINUTES=15
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# Password reset email (optional). Link embedded in emails; default is batiflow://reset-password?token=...
# For a web fallback use https://yourapp.com/reset-password (page must open the app or collect token).
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_MAX_SENDS_PER_HOUR=5
PASSWORD_RESET_LINK_BASE=batiflow://reset-password

# Resend — rotate the key in https://resend.com if it was exposed anywhere.
# Leave RESEND_API_KEY empty for local dev if your stack logs OTPs instead of sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Firebase Admin (required for POST /auth/firebase).
# Create a service account in Firebase Console → Project settings → Service accounts.
# FIREBASE_PRIVATE_KEY: paste the key from JSON; in .env use literal \n for newlines, e.g.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
